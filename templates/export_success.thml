<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Export Complete — ComicCraft
    </title>

    <link
        rel="stylesheet"
        href="/static/style.css"
    >

</head>


<body>

<main class="container">

    <section class="card success">

        <div class="success-icon">
            ✓
        </div>

        <p class="eyebrow">
            EXPORT COMPLETE
        </p>

        <h1>
            Your comic is ready.
        </h1>

        <p>
            The comic PDF has been generated successfully.
        </p>

        <a
            class="button"
            href="/"
        >
            Go Create Another Comic
        </a>

    </section>

</main>

</body>

</html>